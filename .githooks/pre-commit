#!/usr/bin/env bash
# Beacon: дешёвые предохранители для слабого ПК. Работают во всех worktrees.
set -euo pipefail

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
if { [ "$branch" = "main" ] || [ "$branch" = "master" ]; } && [ "${BEACON_ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
  echo "FORBIDDEN: create a feature branch/worktree, never commit to main directly!" >&2
  exit 1
fi

staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [ -n "$staged_go" ]; then
  bad=$(printf '%s\n' "$staged_go" | xargs -r gofmt -l)
  if [ -n "$bad" ]; then
    echo "FORBIDDEN: staged Go files are not gofmt'ed:" >&2
    printf '%s\n' "$bad" >&2
    echo "Fix: gofmt -w <files>" >&2
    exit 1
  fi
fi

staged_all=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged_all" ]; then
  bad=$(printf '%s\n' "$staged_all" | grep -E '(^worktrees/|\.db$|\.db-wal$|\.db-shm$|(^|/)\.opencode/bin/beacon$|^beacon$)' || true)
  if [ -n "$bad" ]; then
    echo "FORBIDDEN: staging worktree output, a DB or the local beacon binary:" >&2
    printf '%s\n' "$bad" >&2
    exit 1
  fi
fi

# Fail-closed проверка сгенерированного индекса карточек. Гейт IDX-04
# пересобирает индекс из docs/tasks и сравнивает байты с закоммиченной копией.
# Ошибка или отсутствие инструмента блокирует коммит. Это отдельная проверка:
# fail-open аренда ниже остаётся без изменений и коммит не блокирует.
if command -v go >/dev/null 2>&1; then
  # cardindex живёт во вложенном модуле tools/beacon-gates. Запускаем его оттуда,
  # а -root ../.. по-прежнему указывает на корень репозитория.
  if index_out=$(cd tools/beacon-gates && go run ./cardindex -root ../.. 2>&1); then
    :
  else
    echo "FORBIDDEN: $index_out" >&2
    echo "Reason: сгенерированный индекс карточек устарел или не собирается. Обновите его через go run ./tools/roadmap-sync --write." >&2
    exit 1
  fi
else
  echo "FORBIDDEN: go не найден, нельзя проверить сгенерированный индекс карточек" >&2
  exit 1
fi

# Advisory-аренды файлов и ворктри. Guard блокирует только живую чужую аренду:
# код 3 от beacon task lease check. Нет бинарника, нет стора, сбой чтения или
# любая другая ошибка пропускают коммит (fail-open).
beacon_bin=${BEACON_BIN:-}
if [ -z "$beacon_bin" ]; then
  if command -v beacon >/dev/null 2>&1; then
    beacon_bin=$(command -v beacon)
  elif [ -x ./beacon ]; then
    beacon_bin=./beacon
  fi
fi

if [ -n "$beacon_bin" ] && [ -x "$beacon_bin" ]; then
  agent=${BEACON_AGENT:-}
  if [ -z "$agent" ]; then
    agent=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
  fi
  if [ -n "$agent" ] && [ "$agent" != "unknown" ]; then
    staged_lease=$(git diff --cached --name-only --diff-filter=ACMR)
    if [ -n "$staged_lease" ]; then
      lease_args=(task lease check --agent "$agent")
      while IFS= read -r lease_file; do
        if [ -n "$lease_file" ]; then
          lease_args+=(--file "$lease_file")
        fi
      done <<< "$staged_lease"
      if lease_out=$("$beacon_bin" "${lease_args[@]}" 2>/dev/null); then
        :
      else
        lease_code=$?
        if [ "$lease_code" -eq 3 ]; then
          echo "FORBIDDEN: $lease_out" >&2
          echo "Reason: staged files are leased by another live agent. Release the lease or set BEACON_AGENT to the owner." >&2
          exit 1
        fi
      fi
    fi
  fi
fi

exit 0
