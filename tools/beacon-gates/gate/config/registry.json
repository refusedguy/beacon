{
  "schema": "beacon.agent-registry/v2",
  "version": "2",
  "project": "beacon-impl-ci",
  "roster": [
    {
      "id": "executor",
      "roles": ["executor"],
      "capabilities": ["watch", "ci-retry"],
      "path": "agents/executor"
    },
    {
      "id": "fixer",
      "roles": ["fixer"],
      "capabilities": ["review"]
    }
  ],
  "limits": {
    "max_retries": 3
  }
}
