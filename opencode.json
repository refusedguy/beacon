{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "description": "Default coding agent. Allowed to create tasks until workers move to the worker agent.",
      "permissions": [
        {
          "action": "beacon_beacon_reconcile",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_reconcile",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_create",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_create",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_delete",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_delete",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_update",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_update",
          "effect": "allow",
          "resource": "*"
        }
      ]
    },
    "orchestrator": {
      "description": "Creates and dispatches Beacon tasks. The only agent allowed to create tasks.",
      "mode": "all",
      "permissions": [
        {
          "action": "beacon_beacon_reconcile",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_reconcile",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_create",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_create",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_delete",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_delete",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_update",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "beacon_task_update",
          "effect": "allow",
          "resource": "*"
        }
      ]
    },
    "worker": {
      "description": "Executes one Beacon task in its own worktree. Cannot create tasks.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "beacon_beacon_reconcile",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_reconcile",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_create",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_task_create",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_delete",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_task_delete",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_beacon_task_update",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "beacon_task_update",
          "effect": "deny",
          "resource": "*"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "beacon_beacon_reconcile",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_reconcile",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_beacon_task_create",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_task_create",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_beacon_task_delete",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_task_delete",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_beacon_task_update",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "beacon_task_update",
      "effect": "deny",
      "resource": "*"
    }
  ]
}
