{
  "noise": {
    "defaultFloorPct": 2,
    "maxAgeHours": 168,
    "minSamples": 5,
    "quantile": 0.95
  },
  "specs": [
    {
      "key": "sqlite-snapshot",
      "limiter": "indexed snapshot reads + WAL pages",
      "unit": "ns",
      "workMetric": "sqlite-snapshot-work",
      "errMetric": "sqlite-snapshot-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "card-parse",
      "limiter": "yaml.Unmarshal + line scan",
      "unit": "ns",
      "workMetric": "card-parse-work",
      "errMetric": "card-parse-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "wire-encode",
      "limiter": "encoding/json reflection",
      "unit": "ns",
      "workMetric": "wire-encode-work",
      "errMetric": "wire-encode-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "redaction",
      "limiter": "regexp pass chain",
      "unit": "ns",
      "workMetric": "redaction-work",
      "errMetric": "redaction-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "mcp-journal",
      "limiter": "mutex + indexed LRU",
      "unit": "ns",
      "workMetric": "mcp-journal-work",
      "errMetric": "mcp-journal-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "sse-fanout",
      "limiter": "json.Marshal + subscriber maps + slow-view drop",
      "unit": "ns",
      "workMetric": "sse-fanout-work",
      "errMetric": "sse-fanout-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "scm-observe",
      "limiter": "loopback PR + compare + checks + files round trips",
      "unit": "ns",
      "workMetric": "scm-observe-work",
      "errMetric": "scm-observe-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "card-local-parse",
      "limiter": "yaml.Unmarshal + per-scope os.Stat",
      "unit": "ns",
      "workMetric": "card-local-parse-work",
      "errMetric": "card-local-parse-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "http-snapshot-assembly",
      "limiter": "groupHistory + json reflection",
      "unit": "ns",
      "workMetric": "http-snapshot-assembly-work",
      "errMetric": "http-snapshot-assembly-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "harness-spawn",
      "limiter": "loopback create + model POST + deferred move",
      "unit": "ns",
      "workMetric": "harness-spawn-work",
      "errMetric": "harness-spawn-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "prompt-build",
      "limiter": "strings.Builder + prompt bytes",
      "unit": "ns",
      "workMetric": "prompt-build-work",
      "errMetric": "prompt-build-errs",
      "placement": "both",
      "thresholdPct": 15
    },
    {
      "key": "snapshot-reads",
      "limiter": "WAL page reads",
      "unit": "ns",
      "workMetric": "snapshot-reads-work",
      "errMetric": "snapshot-errs",
      "placement": "nightly",
      "thresholdPct": 15
    },
    {
      "key": "snapshot-assembly",
      "limiter": "groupHistory + json reflection",
      "unit": "ns",
      "workMetric": "snapshot-assembly-work",
      "errMetric": "snapshot-errs",
      "placement": "nightly",
      "thresholdPct": 15
    },
    {
      "key": "snapshot-total",
      "limiter": "sum of both phases",
      "unit": "ns",
      "workMetric": "",
      "errMetric": "",
      "placement": "nightly",
      "thresholdPct": 15
    },
    {
      "key": "snapshot",
      "limiter": "SQLite VM, ListRunEvents sort and JSON reflection",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "worktree-remove",
      "limiter": "git subprocess spawn and worktree metadata",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "tui-view",
      "limiter": "normalizeSnapshot + render",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "run-watcher-fp",
      "limiter": "JSON.stringify character volume",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "http-frame-emission",
      "limiter": "json.Marshal + eight-subscriber lossy fanout",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "go-tui-view",
      "limiter": "truncate + padding cache + reused row buffer",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "reconcile-tick-counts",
      "limiter": "source ListAvailable + SQLite Get per PR",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "planner-select-injected-checker",
      "limiter": "injected overlap checker over active scope index",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "dispatch-prompt",
      "limiter": "strings.Builder + prompt bytes",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "pr",
      "thresholdPct": 15
    },
    {
      "key": "json-control",
      "limiter": "encoding/json reflection over a fixed struct",
      "unit": "ns",
      "workMetric": "work",
      "errMetric": "errs",
      "placement": "both",
      "thresholdPct": 15
    }
  ]
}
