{
  "contract": "T2.11 tier-1/tier-2 GraphQL response shape: data keyed by alias 'p0', rateLimit.cost",
  "source": "WORKER-PROMPT 4.6 verdict table; T2.16 card; report A (rateLimit.cost = 1 per batch)",
  "note": "Eight cases. The BEHIND case appears twice, once per requireUpToDate policy, so there are nine fixtures but eight distinct case values.",
  "cases": [
    {
      "id": "fork",
      "case": "fork",
      "description": "Fork PR: REST workflow run has empty pull_requests, so the check is bound to the watch by headSHA from the GraphQL tier-1 response. All rollup checks green.",
      "watch": { "repo": "acme/widgets", "pr": 41, "headSHA": "1111111111111111111111111111111111111111" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "fork/tier1.json",
        "tier2": "",
        "rest": [ { "path": "fork/rest-workflow-run.json", "kind": "workflow_run" } ]
      },
      "expected": { "verdict": "ready", "reason": "", "binding": "headSHA" }
    },
    {
      "id": "missing-required",
      "case": "missing-required",
      "description": "All visible checks green, but branch protection requires test and lint which are not created yet. noChecksTimeout leads to timeout and escalation.",
      "watch": { "repo": "acme/widgets", "pr": 42, "headSHA": "2222222222222222222222222222222222222222" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "missing-required/tier1.json",
        "tier2": "missing-required/tier2.json",
        "rest": [ { "path": "missing-required/rest-branch-protection.json", "kind": "branch_protection" } ]
      },
      "expected": { "verdict": "timeout", "reason": "required checks not created: test,lint", "binding": "number" }
    },
    {
      "id": "skipped-neutral",
      "case": "skipped-neutral",
      "description": "SKIPPED and NEUTRAL conclusions are admissible; with rollup SUCCESS, MERGEABLE and CLEAN the verdict is ready.",
      "watch": { "repo": "acme/widgets", "pr": 43, "headSHA": "3333333333333333333333333333333333333333" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "skipped-neutral/tier1.json",
        "tier2": "skipped-neutral/tier2.json",
        "rest": []
      },
      "expected": { "verdict": "ready", "reason": "", "binding": "number" }
    },
    {
      "id": "pending-states",
      "case": "pending-states",
      "description": "ACTION_REQUIRED, WAITING, QUEUED and IN_PROGRESS contexts produce a pending verdict with a reason.",
      "watch": { "repo": "acme/widgets", "pr": 44, "headSHA": "4444444444444444444444444444444444444444" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "pending-states/tier1.json",
        "tier2": "pending-states/tier2.json",
        "rest": []
      },
      "expected": { "verdict": "watching", "reason": "checks pending", "binding": "number" }
    },
    {
      "id": "draft",
      "case": "draft",
      "description": "Draft PR is not ready even though the rollup is SUCCESS and the branch is clean.",
      "watch": { "repo": "acme/widgets", "pr": 45, "headSHA": "5555555555555555555555555555555555555555" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "draft/tier1.json",
        "tier2": "",
        "rest": []
      },
      "expected": { "verdict": "watching", "reason": "draft", "binding": "number" }
    },
    {
      "id": "behind-true",
      "case": "behind",
      "description": "mergeStateStatus BEHIND with requireUpToDate=true requires a rebase.",
      "watch": { "repo": "acme/widgets", "pr": 46, "headSHA": "6666666666666666666666666666666666666666" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "behind-true/tier1.json",
        "tier2": "",
        "rest": []
      },
      "expected": { "verdict": "rebase", "reason": "behind and requireUpToDate", "binding": "number" }
    },
    {
      "id": "behind-false",
      "case": "behind",
      "description": "mergeStateStatus BEHIND with requireUpToDate=false is ready when all other conditions hold.",
      "watch": { "repo": "acme/widgets", "pr": 47, "headSHA": "7777777777777777777777777777777777777777" },
      "policy": { "requireUpToDate": false, "ignoreReviews": false },
      "responses": {
        "tier1": "behind-false/tier1.json",
        "tier2": "",
        "rest": []
      },
      "expected": { "verdict": "ready", "reason": "", "binding": "number" }
    },
    {
      "id": "merged",
      "case": "merged",
      "description": "state MERGED is terminal.",
      "watch": { "repo": "acme/widgets", "pr": 48, "headSHA": "8888888888888888888888888888888888888888" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "merged/tier1.json",
        "tier2": "",
        "rest": []
      },
      "expected": { "verdict": "merged", "reason": "", "binding": "number" }
    },
    {
      "id": "closed",
      "case": "closed",
      "description": "state CLOSED is terminal.",
      "watch": { "repo": "acme/widgets", "pr": 49, "headSHA": "9999999999999999999999999999999999999999" },
      "policy": { "requireUpToDate": true, "ignoreReviews": false },
      "responses": {
        "tier1": "closed/tier1.json",
        "tier2": "",
        "rest": []
      },
      "expected": { "verdict": "closed", "reason": "", "binding": "number" }
    }
  ]
}
